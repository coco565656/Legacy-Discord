// Local-only preview configuration. Production Debug and Release remain unchanged.
ARCHS = arm64
ONLY_ACTIVE_ARCH = YES
MACOSX_DEPLOYMENT_TARGET = 26.0
PRODUCT_NAME = Legacy Discord Dev
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) LEGACY_DISCORD_LOCAL_DEV=1 LEGACY_DISCORD_UI_DIAGNOSTICS=1
LIBRARY_SEARCH_PATHS = $(PROJECT_DIR)/$(TARGET_NAME) $(SDKROOT)/usr/lib $(PROJECT_DIR)
COPY_PHASE_STRIP = NO
